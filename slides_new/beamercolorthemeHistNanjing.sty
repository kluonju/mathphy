\ProvidesPackage{beamercolorthemeHistNanjing}
\mode<presentation>

\definecolor{HistPurple}{RGB}{153,0,153}
\definecolor{HistStone}{RGB}{68,68,68}
\definecolor{HistClay}{RGB}{184,106,51}
\definecolor{HistBlue}{RGB}{28,79,161}

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{structure}{fg=HistPurple}
\setbeamercolor{frametitle}{fg=white,bg=HistPurple}
\setbeamercolor{title}{fg=HistPurple}
\setbeamercolor{block title}{fg=white,bg=HistBlue}
\setbeamercolor{block body}{fg=black,bg=HistStone!10}
\setbeamercolor{item}{fg=HistClay}
\setbeamercolor{subitem}{fg=HistClay}
