% 定义配色
\definecolor{NanjingBlue}{RGB}{39, 92, 154}      % 紫金科技蓝 (#275C9A)
\definecolor{MapleRed}{RGB}{193, 68, 14}         % 枫叶红 (#C1440E)
\definecolor{CloudGray}{RGB}{230, 230, 230}      % 城市浅灰 (#E6E6E6)

% 正文与背景
\setbeamercolor{normal text}{fg=black, bg=white}
\setbeamercolor{background canvas}{bg=CloudGray}

% 结构色（章节、标题、强调）
\setbeamercolor{structure}{fg=NanjingBlue}

% 幻灯片标题
\setbeamercolor{frametitle}{fg=white, bg=NanjingBlue}
\setbeamercolor{title}{fg=NanjingBlue}

% 区块设置
\setbeamercolor{block title}{fg=white, bg=MapleRed}
\setbeamercolor{block body}{fg=black, bg=white}

% 列表符号颜色
\setbeamercolor{item}{fg=MapleRed}
\setbeamercolor{subitem}{fg=MapleRed}

% 目录颜色
\setbeamercolor{section in toc}{fg=NanjingBlue}
\setbeamercolor{subsection in toc}{fg=MapleRed}

% 页脚与导航符号
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{footline}[frame number]